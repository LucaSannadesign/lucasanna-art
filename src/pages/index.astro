---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getEntry, getCollection, type CollectionEntry } from "astro:content";
import { netlifyImageSrcSet, netlifyImageUrl } from "../lib/imageCdn";

const entry = await getEntry("pages", "index");
if (!entry) throw new Error("Missing index page");
const { Content } = await entry.render();

const recentWorks: CollectionEntry<"opere">[] = (await getCollection("opere"))
	.filter((work) => work.slug.includes("/"))
	.sort(
		(a, b) =>
			new Date(b.data.date || 0).getTime() -
			new Date(a.data.date || 0).getTime(),
	)
	.slice(0, 6);

const recentPosts: CollectionEntry<"posts">[] = (await getCollection("posts"))
	.sort(
		(a, b) =>
			new Date(b.data.date || 0).getTime() -
			new Date(a.data.date || 0).getTime(),
	)
	.slice(0, 3);

const homeTitle = "Luca Sanna — pittura contemporanea in Sardegna";
const homeDescription =
	"Opere di Luca Sanna, artista visivo in Sardegna: pittura contemporanea, natura, memoria, paesaggi interiori e ricerca sul segno.";
const homeOgImage = "/images/og/luca-sanna-home.jpg";
const heroImage = entry.data.featuredImage;
---

<BaseLayout
	title={homeTitle}
	description={homeDescription}
	image={homeOgImage}
	ogImageWidth={1200}
	ogImageHeight={630}
	canonicalUrl="https://lucasanna.art/"
>
	<section class="max-w-5xl mx-auto mb-14 md:mb-20 pt-3 md:pt-0 md:-mt-6 text-center">
		{
			heroImage && (
				<picture class="block w-full mb-10 md:mb-12">
					<source
						type="image/avif"
						srcset={netlifyImageSrcSet(heroImage, [480, 768, 1024, 1200], 68, "avif")}
						sizes="(max-width: 768px) calc(100vw - 2rem), (max-width: 1100px) calc(100vw - 4rem), 960px"
					/>
					<img
						src={netlifyImageUrl(heroImage, 1200, 78)}
						srcset={netlifyImageSrcSet(heroImage, [480, 768, 1024, 1200], 78)}
						sizes="(max-width: 768px) calc(100vw - 2rem), (max-width: 1100px) calc(100vw - 4rem), 960px"
						alt="Luca Sanna"
						fetchpriority="high"
						loading="eager"
						decoding="async"
						class="w-full h-[46vh] min-h-[300px] max-h-[520px] md:h-[62vh] md:max-h-[720px] object-cover transition-[filter] duration-1000 ease-in-out shadow-2xl [@media(hover:hover)_and_(pointer:fine)]:grayscale [@media(hover:hover)_and_(pointer:fine)]:hover:grayscale-0"
					/>
				</picture>
			)
		}
		<div
			class="home-editorial-content prose prose-invert lg:prose-xl mx-auto font-light text-gray-300 leading-relaxed"
		>
			<Content />
		</div>
	</section>

	<style is:global>
		.home-hero-cta {
			display: flex;
			flex-direction: column;
			align-items: center;
			justify-content: center;
			gap: 1rem;
			margin-top: 0.5rem;
			margin-bottom: 0.5rem;
		}
		@media (min-width: 640px) {
			.home-hero-cta {
				flex-direction: row;
				flex-wrap: wrap;
				gap: 1.5rem;
			}
		}
		.home-editorial-content .home-hero-cta-primary {
			display: inline-block;
			margin: 0;
			padding: 0.5rem 1.25rem;
			font-size: 0.75rem;
			font-weight: 500;
			letter-spacing: 0.2em;
			text-transform: uppercase;
			text-decoration: none;
			color: #e8e8e8;
			border: 1px solid rgba(255, 255, 255, 0.22);
			border-radius: 0.125rem;
			transition: color 0.2s ease, border-color 0.2s ease, background-color 0.2s ease;
		}
		.home-editorial-content .home-hero-cta-primary:hover {
			color: #ffffff;
			border-color: rgba(255, 255, 255, 0.42);
			background-color: rgba(255, 255, 255, 0.04);
		}
		.home-editorial-content .home-hero-cta-secondary {
			display: inline-block;
			margin: 0;
			font-size: 0.875rem;
			font-weight: 300;
			letter-spacing: 0.04em;
			text-transform: none;
			text-decoration: none;
			color: #9ca3af;
			border-bottom: 1px solid rgba(255, 255, 255, 0.12);
			padding-bottom: 0.15rem;
			transition: color 0.2s ease, border-color 0.2s ease;
		}
		.home-editorial-content .home-hero-cta-secondary:hover {
			color: #d1d5db;
			border-color: rgba(255, 255, 255, 0.28);
		}
		.home-below-fold {
			content-visibility: auto;
			contain-intrinsic-size: auto 1100px;
		}
	</style>

	<section class="home-below-fold mb-16 md:mb-24">
		<h2
			class="text-3xl md:text-4xl font-heading font-normal text-center mb-10 md:mb-12 uppercase tracking-[0.2em] text-white"
		>
			Opere recenti dal percorso visivo
		</h2>
		<div
			class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-x-8 gap-y-10"
		>
			{
				recentWorks.map((work) => {
					const image = work.data.featuredImage;
					return (
						<a href={`/opere/${work.slug}/`} class="group block">
							<div class="aspect-[4/5] overflow-hidden bg-[#1a1a1a] mb-6">
								{image && (
									<img
										src={netlifyImageUrl(image, 640, 76)}
										srcset={netlifyImageSrcSet(image, [320, 480, 640, 800], 76)}
										sizes="(max-width: 767px) calc(100vw - 2rem), (max-width: 1023px) 45vw, 30vw"
										alt={work.data.imageAlt || work.data.title}
										loading="lazy"
										decoding="async"
										class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-1000 ease-out"
									/>
								)}
							</div>
							<div class="text-center">
								<h3 class="text-xl font-heading text-white mb-2 group-hover:text-gray-300 transition-colors">
									{work.data.title}
								</h3>
								{work.data.technique && (
									<p class="text-xs text-gray-500 uppercase tracking-widest mb-1">
										{work.data.technique}
									</p>
								)}
							</div>
						</a>
					);
				})
			}
		</div>
		<div class="text-center mt-12">
			<a
				href="/opere/"
				class="inline-block border-b border-white pb-1 text-sm uppercase tracking-[0.2em] hover:text-gray-400 hover:border-gray-400 transition-all"
			>
				Vedi tutte le opere
			</a>
		</div>
	</section>

	<section class="home-below-fold mb-14 md:mb-20">
		<h2
			class="text-3xl md:text-4xl font-heading font-normal text-center mb-10 md:mb-12 uppercase tracking-[0.2em] text-white"
		>
			Dal Blog
		</h2>
		<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 md:gap-10">
			{
				recentPosts.map((post) => {
					const image = post.data.featuredImage;
					return (
						<a href={`/${post.slug}/`} class="block group">
							<div class="aspect-[3/2] overflow-hidden bg-[#1a1a1a] mb-6">
								{image && (
									<img
										src={netlifyImageUrl(image, 640, 74)}
										srcset={netlifyImageSrcSet(image, [320, 480, 640, 800], 74)}
										sizes="(max-width: 767px) calc(100vw - 2rem), (max-width: 1023px) 45vw, 30vw"
										alt={post.data.title}
										loading="lazy"
										decoding="async"
										class="w-full h-full object-cover opacity-90 group-hover:opacity-100 group-hover:scale-105 transition-[opacity,transform] duration-700"
									/>
								)}
							</div>
							<div>
								<div class="text-xs text-gray-500 mb-3 uppercase tracking-widest">
									{new Date(post.data.date).toLocaleDateString(
										"it-IT",
										{
											year: "numeric",
											month: "long",
											day: "numeric",
										},
									)}
								</div>
								<h3 class="text-2xl font-heading text-white mb-4 leading-tight group-hover:underline decoration-1 underline-offset-4">
									{post.data.title}
								</h3>
								{post.data.description && (
									<p class="text-sm text-gray-400 leading-relaxed line-clamp-3">
										{post.data.description}
									</p>
								)}
							</div>
						</a>
					);
				})
			}
		</div>
		<div class="text-center mt-12">
			<a
				href="/blog-arte/"
				class="inline-block border-b border-white pb-1 text-sm uppercase tracking-[0.2em] hover:text-gray-400 hover:border-gray-400 transition-all"
			>
				Vai al blog
			</a>
		</div>
	</section>

	<script>
		function initHomeEditorialCta() {
			const root = document.querySelector(".home-editorial-content");
			if (!root || root.querySelector(".home-hero-cta")) return;
			const a1 = root.querySelector('a[href="/opere/"]');
			const a2 = root.querySelector('a[href="/biografia-luca-sanna/"]');
			if (!a1 || !a2) return;
			const p1 = a1.parentElement;
			const p2 = a2.parentElement;
			if (p1?.tagName !== "P" || p2?.tagName !== "P" || p1.nextElementSibling !== p2) return;
			const wrap = document.createElement("div");
			wrap.className = "home-hero-cta";
			p1.insertAdjacentElement("beforebegin", wrap);
			wrap.append(a1, a2);
			a1.classList.add("home-hero-cta-primary");
			a2.classList.add("home-hero-cta-secondary");
			p1.remove();
			p2.remove();
		}

		initHomeEditorialCta();
		document.addEventListener("astro:page-load", initHomeEditorialCta);
	</script>
</BaseLayout>
