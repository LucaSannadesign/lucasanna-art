---
import BaseLayout from "../layouts/BaseLayout.astro";
import ContactFormScript from "../components/ContactFormScript.astro";
import { getEntry } from "astro:content";

const entry = await getEntry("pages", "contatti");
if (!entry) throw new Error("Contact page not found");
const { Content } = await entry.render();
---

<BaseLayout
    title="Contatti | Luca Sanna"
    description={entry.data.description}
    context="page"
>
    <div class="max-w-3xl mx-auto px-4 pt-4 pb-12 md:pt-8 md:pb-24">
        <h1
            class="text-4xl md:text-6xl font-heading font-normal text-center mb-12 md:mb-14 text-white uppercase tracking-[0.2em]"
        >
            Contatti
        </h1>

        <div class="contact-page-content prose prose-invert mx-auto text-gray-300 font-light leading-relaxed tracking-wide">
            <Content />
        </div>

        <section class="mt-12 md:mt-14 border-t border-white/10 pt-8 md:pt-10">
            <h2 class="text-xs uppercase tracking-[0.2em] text-gray-500 mb-6 text-center">
                Invia una richiesta
            </h2>
            <form
                name="contatti"
                method="POST"
                action="/api/contatti"
                data-contact-form
                class="max-w-xl mx-auto grid grid-cols-1 gap-5"
            >
                <input type="hidden" name="form-name" value="contatti" />
                <input type="hidden" name="form-started-at" data-form-started-at value="" />
                <p class="hidden" aria-hidden="true">
                    <label>
                        Non compilare questo campo:
                        <input name="bot-field" tabindex="-1" autocomplete="off" />
                    </label>
                </p>

                <p
                    data-contact-error
                    role="alert"
                    hidden
                    class="border border-red-500/40 bg-red-500/5 px-4 py-3 text-sm text-red-300"
                >
                </p>

                <label class="block">
                    <span class="text-[11px] uppercase tracking-[0.16em] text-gray-400">Nome</span>
                    <input
                        type="text"
                        name="nome"
                        required
                        class="mt-2 w-full bg-[#141414] border border-white/15 px-4 py-3 text-sm text-gray-200 placeholder:text-gray-500 focus:outline-none focus:border-white/40"
                    />
                </label>

                <label class="block">
                    <span class="text-[11px] uppercase tracking-[0.16em] text-gray-400">Email</span>
                    <input
                        type="email"
                        name="email"
                        required
                        class="mt-2 w-full bg-[#141414] border border-white/15 px-4 py-3 text-sm text-gray-200 placeholder:text-gray-500 focus:outline-none focus:border-white/40"
                    />
                </label>

                <label class="block">
                    <span class="text-[11px] uppercase tracking-[0.16em] text-gray-400">Tipo richiesta</span>
                    <select
                        name="tipo-richiesta"
                        required
                        class="mt-2 w-full bg-[#141414] border border-white/15 px-4 py-3 text-sm text-gray-200 focus:outline-none focus:border-white/40"
                    >
                        <option value="">Seleziona</option>
                        <option value="Acquisto opera">Acquisto opera</option>
                        <option value="Commissione personalizzata">Commissione personalizzata</option>
                        <option value="Collaborazione">Collaborazione</option>
                        <option value="Informazioni generali">Informazioni generali</option>
                    </select>
                </label>

                <label class="block">
                    <span class="text-[11px] uppercase tracking-[0.16em] text-gray-400">Messaggio</span>
                    <textarea
                        name="messaggio"
                        rows="6"
                        required
                        class="mt-2 w-full bg-[#141414] border border-white/15 px-4 py-3 text-sm text-gray-200 placeholder:text-gray-500 focus:outline-none focus:border-white/40"
                    ></textarea>
                </label>

                <div class="pt-2 text-center">
                    <button
                        type="submit"
                        class="inline-block border border-white/25 px-6 py-3 text-xs uppercase tracking-[0.2em] text-gray-200 hover:text-white hover:border-white/50 transition-colors"
                    >
                        Invia richiesta
                    </button>
                </div>
            </form>
        </section>
    </div>

    <ContactFormScript />

    <script>
        const contactRoot = document.querySelector(".contact-page-content");

        if (contactRoot) {
            const junkPatterns = [
                "LS CONTACT",
                "Ninja Forms",
                "PATCH: mobile double-border",
                "formDisplay=1",
                "Avviso: JavaScript è obbligatorio",
            ];

            contactRoot.querySelectorAll("p, a, script").forEach((node) => {
                const text = (node.textContent || "").trim();
                const isJunk = junkPatterns.some((pattern) =>
                    text.includes(pattern),
                );

                if (
                    node.tagName === "SCRIPT" ||
                    isJunk ||
                    (node.tagName === "A" && !node.getAttribute("href"))
                ) {
                    node.remove();
                }
            });
        }
    </script>
</BaseLayout>

<style is:global>
    /* 
    Raffina lo stile della pagina contatti rimuovendo i residui di WordPress
    e uniformando il design al tema minimale del sito.
  */

    .contact-page-content .ls-contact {
        background: transparent !important;
        border: none !important;
        padding: 0 !important;
        margin: 0 !important;
    }

    .contact-page-content .ls-contact:before,
    .contact-page-content .ls-contact__title,
    .contact-page-content .ls-contact__badge,
    .contact-page-content .ls-contact__dot {
        display: none !important;
    }

    .contact-page-content .ls-contact__lead {
        color: #a8a8a8 !important;
        font-size: 1.1rem !important;
        line-height: 1.8 !important;
        margin-bottom: 3rem !important;
        text-align: center;
    }

    .contact-page-content .ls-panel {
        background: transparent !important;
        border: 1px solid rgba(255, 255, 255, 0.05) !important;
        padding: 2rem !important;
        margin-bottom: 2rem !important;
    }

    .contact-page-content .ls-panel__title {
        color: #fff !important;
        font-size: 0.75rem !important;
        letter-spacing: 0.2em !important;
        text-transform: uppercase !important;
        margin-bottom: 1.5rem !important;
        opacity: 0.6;
    }

    .contact-page-content a {
        color: #fff !important;
        text-decoration: none !important;
        border-bottom: 1px solid rgba(255,255,255,0.1);
        padding-bottom: 2px;
        transition: all 0.3s ease;
    }

    .contact-page-content a:hover {
        border-bottom-color: #fff;
        opacity: 0.8;
    }

    /* Hide the form if it's still present in the markdown but non-functional */
    .contact-page-content .ls-contact__form, 
    .contact-page-content .nf-form-wrap {
        display: none !important;
    }
</style>
