---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection, type CollectionEntry } from "astro:content";
import { featuredWorksEnByItSlug } from "../../i18n/featuredWorks.en";

const works: CollectionEntry<"opere">[] = (await getCollection("opere"))
    .filter((work) => work.slug.includes("/"))
    .sort(
        (a, b) =>
            new Date(b.data.date || 0).getTime() -
            new Date(a.data.date || 0).getTime(),
    );

const categoryLabels: Record<string, string> = {
    animali: "Animals",
    pittura: "Painting",
    grafica: "Graphic work",
    paesaggio: "Landscape",
    ritratti: "Portraits",
    opere: "Works",
};

const getCategory = (work: CollectionEntry<"opere">) => {
    const explicit = work.data.categories?.[0]?.toLowerCase();
    return explicit || work.slug.split("/")[0]?.toLowerCase() || "other";
};

const categories = Array.from(new Set(works.map(getCategory))).filter(Boolean);

const translateTechnique = (value?: string) => {
    if (!value) return "";
    return value
        .replace(/disegno digitale \(procreate\)/gi, "digital drawing (Procreate)")
        .replace(/carboncino su carta/gi, "charcoal on paper")
        .replace(/acrilico su tela/gi, "acrylic on canvas")
        .replace(/olio su tela/gi, "oil on canvas")
        .replace(/acquerello su carta/gi, "watercolour on paper")
        .replace(/grafite su carta/gi, "graphite on paper")
        .replace(/matita su carta/gi, "pencil on paper")
        .replace(/tecnica mista/gi, "mixed media")
        .replace(/acquerello/gi, "watercolour")
        .replace(/acrilico/gi, "acrylic")
        .replace(/olio/gi, "oil")
        .replace(/matita/gi, "pencil")
        .replace(/carboncino/gi, "charcoal");
};
---

<BaseLayout
    title="Works | Luca Sanna"
    description="Selected paintings, drawings and visual works by Luca Sanna, exploring nature, memory, metamorphosis and inner landscapes."
    canonicalUrl="https://lucasanna.art/en/works/"
    locale="en"
>
    <div class="-mt-4 pb-12 md:-mt-16 md:pb-20 px-4">
        <section class="max-w-7xl mx-auto mb-10 md:mb-14 pb-8 md:pb-10 border-b border-white/10" aria-labelledby="works-title">
            <div class="grid gap-8 md:grid-cols-[minmax(0,0.85fr)_minmax(0,1.15fr)] md:gap-12 lg:gap-20 md:items-end">
                <div class="max-w-xl">
                    <p class="mb-4 text-[0.65rem] uppercase tracking-[0.24em] text-gray-600">Visual archive</p>
                    <h1 id="works-title" class="text-5xl md:text-7xl font-heading font-normal mb-4 uppercase tracking-[0.12em] text-white">Works</h1>
                    <p class="text-xs uppercase tracking-[0.16em] text-gray-500 leading-relaxed">
                        Painting, drawing and image-making across nature, figure, memory and transformation.
                    </p>
                </div>

                <div class="md:pb-1">
                    <div class="hidden md:flex flex-wrap justify-end gap-x-7 gap-y-2" role="toolbar" aria-label="Filter works by category">
                        <button type="button" class="works-filter text-xs uppercase tracking-[0.16em] text-white border-b border-white/50" data-filter="all" aria-pressed="true">All</button>
                        {
                            categories.map((category) => (
                                <button
                                    type="button"
                                    class="works-filter text-xs uppercase tracking-[0.16em] text-gray-500 border-b border-transparent"
                                    data-filter={category}
                                    aria-pressed="false"
                                >
                                    {categoryLabels[category] || category}
                                </button>
                            ))
                        }
                    </div>

                    <div class="md:hidden">
                        <label for="works-filter-select" class="sr-only">Filter works by category</label>
                        <select id="works-filter-select" class="w-full bg-[#141414] border border-white/15 text-gray-300 text-sm px-4 py-3 uppercase tracking-[0.14em]">
                            <option value="all">All</option>
                            {categories.map((category) => <option value={category}>{categoryLabels[category] || category}</option>)}
                        </select>
                    </div>
                </div>
            </div>
        </section>

        <div id="works-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-x-10 gap-y-20 max-w-7xl mx-auto">
            {
                works.map((work) => {
                    const category = getCategory(work);
                    const translated = featuredWorksEnByItSlug.get(work.slug);
                    const href = translated
                        ? `/en/works/${translated.enSlug}/`
                        : `/opere/${work.slug}/`;

                    return (
                        <a
                            href={href}
                            lang={translated ? undefined : "it"}
                            class="group block work-card"
                            data-category={category}
                            aria-label={translated
                                ? `${work.data.title} — English artwork page`
                                : `${work.data.title} — artwork page in Italian`}
                        >
                            <div class="aspect-[4/5] overflow-hidden bg-[#1a1a1a] mb-6 relative">
                                {work.data.featuredImage ? (
                                    <img
                                        src={work.data.featuredImage}
                                        alt={translated?.imageAlt || work.data.imageAlt || work.data.title}
                                        class="w-full h-full object-cover transition-transform duration-1000 ease-out group-hover:scale-[1.025]"
                                    />
                                ) : (
                                    <div class="w-full h-full flex items-center justify-center text-gray-600 uppercase tracking-widest text-xs">No image</div>
                                )}
                            </div>
                            <div class="text-center">
                                <h2 class="text-xl font-heading text-white mb-2 group-hover:text-gray-300 transition-colors" lang="it">{work.data.title}</h2>
                                {translated && (
                                    <p class="mb-2 text-sm font-heading italic text-gray-400">{translated.englishTitle}</p>
                                )}
                                {work.data.technique && (
                                    <p class="text-xs text-gray-500 uppercase tracking-widest mb-1">{translated?.technique || translateTechnique(work.data.technique)}</p>
                                )}
                                {work.data.year && <p class="text-[0.68rem] text-gray-600 tracking-widest">{work.data.year}</p>}
                            </div>
                        </a>
                    );
                })
            }
        </div>
    </div>

    <script is:inline>
        const initWorksFilters = () => {
            const cards = Array.from(document.querySelectorAll('.work-card'));
            const buttons = Array.from(document.querySelectorAll('.works-filter'));
            const select = document.getElementById('works-filter-select');

            const applyFilter = (value) => {
                const active = (value || 'all').toLowerCase();
                cards.forEach((card) => {
                    const category = (card.getAttribute('data-category') || '').toLowerCase();
                    card.style.display = active === 'all' || category === active ? '' : 'none';
                });
                buttons.forEach((button) => {
                    const isActive = (button.dataset.filter || 'all') === active;
                    button.setAttribute('aria-pressed', isActive ? 'true' : 'false');
                    button.classList.toggle('text-white', isActive);
                    button.classList.toggle('text-gray-500', !isActive);
                    button.classList.toggle('border-white/50', isActive);
                    button.classList.toggle('border-transparent', !isActive);
                });
                if (select && select.value !== active) select.value = active;
            };

            buttons.forEach((button) => button.addEventListener('click', () => applyFilter(button.dataset.filter || 'all')));
            if (select) select.addEventListener('change', () => applyFilter(select.value));
        };

        initWorksFilters();
        document.addEventListener('astro:page-load', initWorksFilters);
    </script>
</BaseLayout>
