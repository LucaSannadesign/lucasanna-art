---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection, type CollectionEntry } from "astro:content";

const posts: CollectionEntry<"posts">[] = (await getCollection("posts"))
    .sort(
        (a, b) =>
            new Date(b.data.date || 0).getTime() -
            new Date(a.data.date || 0).getTime(),
    )
    .filter((post) => post.slug !== "blog-arte");

const title = "Art Blog | Luca Sanna";
const description =
    "Notes on art, visual practice, materials, technology and creative research by Luca Sanna.";
---

<BaseLayout
    title={title}
    description={description}
    canonicalUrl="https://lucasanna.art/en/art-blog/"
    context="blog"
    locale="en"
>
    <section class="max-w-6xl mx-auto px-4 pt-4 pb-12 md:pt-8 md:pb-20">
        <header class="mb-16 text-center">
            <p class="mb-4 text-[0.65rem] uppercase tracking-[0.22em] text-gray-600">Writing & process</p>
            <h1 class="text-5xl md:text-7xl font-heading font-normal mb-8 md:mb-9 text-white uppercase tracking-[0.2em]">Art Blog</h1>
            <p class="text-lg text-gray-400 max-w-2xl mx-auto font-light leading-relaxed">{description}</p>
            <p class="mt-6 text-xs uppercase tracking-[0.14em] text-gray-600">
                Article pages are currently available in Italian; English editions are being prepared.
            </p>
        </header>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-x-10 gap-y-24">
            {
                posts.map((post) => (
                    <a href={`/${post.slug}/`} lang="it" class="block group" aria-label={`${post.data.title} — article in Italian`}>
                        <div class="aspect-[3/2] overflow-hidden bg-[#1a1a1a] mb-6 relative">
                            {post.data.featuredImage ? (
                                <img
                                    src={post.data.featuredImage}
                                    alt={post.data.title}
                                    class="w-full h-full object-cover transition-transform duration-1000 ease-out group-hover:scale-105"
                                />
                            ) : (
                                <div class="w-full h-full bg-[#1a1a1a] flex items-center justify-center text-gray-600 font-light tracking-widest uppercase text-sm">No image</div>
                            )}
                        </div>
                        <div class="pr-4">
                            <time
                                datetime={new Date(post.data.date).toISOString()}
                                class="text-xs text-gray-500 uppercase tracking-widest"
                            >
                                {new Date(post.data.date).toLocaleDateString("en-GB", {
                                    year: "numeric",
                                    month: "long",
                                    day: "numeric",
                                })}
                            </time>
                            <h2 class="text-2xl font-heading text-white mt-3 mb-3 leading-tight group-hover:text-gray-300 transition-colors">
                                {post.data.title}
                            </h2>
                            <p class="text-[0.65rem] uppercase tracking-[0.16em] text-gray-600">Italian article</p>
                        </div>
                    </a>
                ))
            }
        </div>
    </section>
</BaseLayout>
