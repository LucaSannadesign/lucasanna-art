---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ContactFormScript from "../../components/ContactFormScript.astro";
---

<BaseLayout
    title="Contact | Luca Sanna"
    description="Contact Luca Sanna for original works, commissions, exhibitions and collaborations."
    canonicalUrl="https://lucasanna.art/en/contact/"
    context="page"
    locale="en"
>
    <div class="-mt-4 px-4 pb-12 md:-mt-16 md:pb-20">
        <section class="max-w-5xl mx-auto" aria-labelledby="contact-title">
            <header class="grid gap-8 border-b border-white/10 pb-8 md:grid-cols-[minmax(0,0.82fr)_minmax(0,1.18fr)] md:items-end md:gap-12 md:pb-10 lg:gap-20">
                <div>
                    <p class="mb-4 text-[0.65rem] uppercase tracking-[0.24em] text-gray-600">Direct contact</p>
                    <h1 id="contact-title" class="mb-4 text-5xl font-heading font-normal uppercase tracking-[0.12em] text-white md:text-7xl">Contact</h1>
                    <p class="text-xs uppercase leading-relaxed tracking-[0.16em] text-gray-500">Original works and commissioned paintings</p>
                </div>

                <div class="md:pb-1">
                    <h2 class="mb-3 font-heading text-2xl text-white md:text-3xl">Request information</h2>
                    <p class="max-w-2xl text-sm font-light leading-7 text-gray-400">
                        Tell me the subject, dimensions, timeframe and, if possible, an indicative budget. I usually reply within 24–48 hours.
                    </p>

                    <nav class="mt-5 flex flex-wrap gap-x-6 gap-y-3" aria-label="Contact channels">
                        <a href="https://wa.me/393403223494" target="_blank" rel="noopener noreferrer" class="contact-action">WhatsApp <span aria-hidden="true">↗</span></a>
                        <a href="mailto:info@lucasanna.art" class="contact-action">Email <span aria-hidden="true">↗</span></a>
                        <a href="/en/works/" class="contact-action">View works <span aria-hidden="true">→</span></a>
                    </nav>
                </div>
            </header>

            <div class="mt-8 grid gap-10 md:mt-10 md:grid-cols-[minmax(0,0.7fr)_minmax(0,1.3fr)] md:gap-12 lg:gap-20">
                <aside class="contact-details md:border-r md:border-white/10 md:pr-10">
                    <p class="mb-6 text-[0.65rem] uppercase tracking-[0.22em] text-gray-600">Practical information</p>
                    <dl class="space-y-5">
                        <div>
                            <dt class="contact-detail-label">Timeframe</dt>
                            <dd class="contact-detail-value">1–3 weeks, depending on format and complexity</dd>
                        </div>
                        <div>
                            <dt class="contact-detail-label">Studio</dt>
                            <dd class="contact-detail-value">Sassari, Sardinia, Italy</dd>
                        </div>
                        <div>
                            <dt class="contact-detail-label">Delivery</dt>
                            <dd class="contact-detail-value">Shipping available throughout Italy</dd>
                        </div>
                    </dl>

                    <div class="mt-8 border-t border-white/10 pt-6">
                        <h3 class="mb-3 text-[0.65rem] uppercase tracking-[0.2em] text-gray-500">For a faster reply</h3>
                        <p class="text-sm font-light leading-6 text-gray-400">Include dimensions, deadline and a visual reference. To attach an image, use WhatsApp or email.</p>
                    </div>

                    <p class="mt-7 text-[0.68rem] tracking-wide text-gray-600">
                        <a href="/privacy-policy/" lang="it" class="contact-legal">Privacy policy (Italian)</a>
                        <span aria-hidden="true"> · </span>
                        <a href="/termini-e-condizioni/" lang="it" class="contact-legal">Terms and conditions (Italian)</a>
                    </p>
                </aside>

                <section aria-labelledby="contact-form-title">
                    <div class="mb-6 flex items-end justify-between gap-4">
                        <div>
                            <p class="mb-2 text-[0.65rem] uppercase tracking-[0.22em] text-gray-600">Form</p>
                            <h2 id="contact-form-title" class="font-heading text-2xl text-white md:text-3xl">Send an enquiry</h2>
                        </div>
                        <span class="hidden text-[0.65rem] uppercase tracking-[0.16em] text-gray-600 sm:block">Reply 24–48h</span>
                    </div>

                    <form
                        name="contatti"
                        method="POST"
                        action="/api/contatti"
                        data-contact-form
                        class="grid grid-cols-1 gap-5 md:grid-cols-2"
                    >
                        <input type="hidden" name="form-name" value="contatti" />
                        <input type="hidden" name="locale" value="en" />
                        <input type="hidden" name="form-started-at" data-form-started-at value="" />
                        <p class="hidden" aria-hidden="true">
                            <label>Leave this field empty:<input name="bot-field" tabindex="-1" autocomplete="off" /></label>
                        </p>

                        <p data-contact-error role="alert" hidden class="border border-red-500/40 bg-red-500/5 px-4 py-3 text-sm text-red-300 md:col-span-2"></p>

                        <label class="block">
                            <span class="contact-field-label">Name</span>
                            <input type="text" name="nome" required class="contact-field" />
                        </label>

                        <label class="block">
                            <span class="contact-field-label">Email</span>
                            <input type="email" name="email" required class="contact-field" />
                        </label>

                        <label class="block md:col-span-2">
                            <span class="contact-field-label">Enquiry type</span>
                            <select name="tipo-richiesta" required class="contact-field">
                                <option value="">Select</option>
                                <option value="Acquisto opera">Purchase an artwork</option>
                                <option value="Commissione personalizzata">Commission</option>
                                <option value="Collaborazione">Collaboration</option>
                                <option value="Informazioni generali">General information</option>
                            </select>
                        </label>

                        <label class="block md:col-span-2">
                            <span class="contact-field-label">Message</span>
                            <textarea name="messaggio" rows="6" required class="contact-field resize-y"></textarea>
                        </label>

                        <div class="pt-1 md:col-span-2 md:text-right">
                            <button type="submit" class="inline-block border border-white/25 px-6 py-3 text-xs uppercase tracking-[0.2em] text-gray-200 transition-colors hover:border-white/50 hover:text-white">Send enquiry</button>
                        </div>
                    </form>
                </section>
            </div>
        </section>
    </div>

    <ContactFormScript locale="en" />
</BaseLayout>

<style>
    .contact-action {
        border-bottom: 1px solid rgba(255, 255, 255, 0.16);
        padding-bottom: 0.35rem;
        color: rgba(220, 220, 220, 0.82);
        font-size: 0.68rem;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        transition: border-color 180ms ease, color 180ms ease;
    }
    .contact-action:hover { border-color: rgba(255, 255, 255, 0.7); color: #fff; }
    .contact-detail-label,
    .contact-field-label {
        color: rgba(145, 145, 145, 0.9);
        font-size: 0.68rem;
        letter-spacing: 0.16em;
        text-transform: uppercase;
    }
    .contact-detail-value {
        margin-top: 0.4rem;
        color: rgba(224, 224, 224, 0.86);
        font-size: 0.875rem;
        font-weight: 300;
        line-height: 1.55;
    }
    .contact-field {
        margin-top: 0.5rem;
        width: 100%;
        border: 1px solid rgba(255, 255, 255, 0.15);
        background: #141414;
        padding: 0.78rem 1rem;
        color: #e5e5e5;
        font-size: 0.875rem;
        outline: none;
        transition: border-color 180ms ease, background-color 180ms ease;
    }
    .contact-field:focus { border-color: rgba(255, 255, 255, 0.45); background: #171717; }
    .contact-legal { border-bottom: 1px solid transparent; transition: border-color 180ms ease, color 180ms ease; }
    .contact-legal:hover { border-color: rgba(255, 255, 255, 0.25); color: rgba(220, 220, 220, 0.9); }
</style>
