---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
    title="Enquiry sent | Luca Sanna"
    description="Thank you. Your message has been sent successfully."
    canonicalUrl="https://lucasanna.art/en/thank-you/"
    context="page"
    locale="en"
>
    <section class="max-w-3xl mx-auto px-4 pt-6 pb-12 md:pt-10 md:pb-20 text-center">
        <h1 class="text-4xl md:text-6xl font-heading font-normal text-white mb-8 uppercase tracking-[0.2em]">
            Enquiry sent
        </h1>
        <p class="text-gray-300 font-light leading-relaxed max-w-2xl mx-auto mb-10">
            Thank you. Your message has been sent successfully. I will reply by email as soon as possible, usually within 24–48 hours.
        </p>
        <a
            href="/en/works/"
            class="inline-block border-b border-white pb-1 text-xs uppercase tracking-[0.2em] hover:text-gray-400 hover:border-gray-400 transition-all"
        >
            Return to the works
        </a>
    </section>
</BaseLayout>
