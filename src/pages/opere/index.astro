---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PercorsoTrigger from "../../components/PercorsoTrigger.astro";
import PercorsoOverlay from "../../components/PercorsoOverlay.astro";
import RevealNarrativo from "../../components/RevealNarrativo.astro";
import TestoMutabile from "../../components/TestoMutabile.astro";
import MemoriaVisiva from "../../components/MemoriaVisiva.astro";
import AtmosferaCromatica from "../../components/AtmosferaCromatica.astro";
import OperaCard from "../../components/OperaCard.astro";
import GalleriaInterattiva from "../../components/GalleriaInterattiva.astro";
import { CATEGORY_LABELS, getArtworks, getWorkCategory } from "../../lib/opere";
import { buildPercorsoWorks } from "../../lib/percorso";

const INTERACTIONS = {
    reveal: true,
    mutableText: true,
    memoriaVisiva: true,
};

const sortedWorks = await getArtworks();

const availableCategories = Array.from(
    new Set(sortedWorks.map((work) => getWorkCategory(work))),
).filter(Boolean);

const percorsoWorks = await buildPercorsoWorks(sortedWorks);
---

<BaseLayout
    title="Opere | Luca Sanna"
    description="Galleria delle opere di Luca Sanna"
    viewTransitions
>
    <div class="-mt-4 pb-12 md:-mt-16 md:pb-20 px-4">
        <section
            class="opere-intro max-w-7xl mx-auto mb-10 md:mb-14 pb-8 md:pb-10 border-b border-white/10"
            aria-labelledby="opere-title"
        >
            <div
                class="grid gap-8 md:grid-cols-[minmax(0,0.85fr)_minmax(0,1.15fr)] md:gap-12 lg:gap-20 md:items-end"
            >
                <div class="max-w-xl">
                    <p
                        class="mb-4 text-[0.65rem] uppercase tracking-[0.24em] text-gray-600"
                    >
                        Archivio visivo
                    </p>
                    <h1
                        id="opere-title"
                        class="text-5xl md:text-7xl font-heading font-normal mb-4 uppercase tracking-[0.12em] text-white"
                    >
                        Opere
                    </h1>

                    <TestoMutabile
                        enabled={INTERACTIONS.mutableText}
                        intervalMs={24000}
                        variants={[
                            "Una soglia tra visione e memoria.",
                            "Ogni opera cambia al variare dello sguardo.",
                            "Il ritmo dell'archivio è un invito alla lentezza.",
                        ]}
                        className="text-xs uppercase tracking-[0.16em] text-gray-500"
                    />
                </div>

                <div class="md:pb-1">
                    <div
                        class="hidden md:flex flex-wrap justify-end gap-x-7 gap-y-2"
                        role="toolbar"
                        aria-label="Filtra opere per categoria"
                    >
                        <button
                            type="button"
                            class="opere-filter-btn opere-filter-btn--editorial text-xs uppercase tracking-[0.16em]"
                            data-filter="all"
                            aria-pressed="true"
                        >
                            Tutte
                        </button>

                        {
                            availableCategories.map((category) => (
                                <button
                                    type="button"
                                    class="opere-filter-btn opere-filter-btn--editorial text-xs uppercase tracking-[0.16em]"
                                    data-filter={category}
                                    aria-pressed="false"
                                >
                                    {CATEGORY_LABELS[category] || category}
                                </button>
                            ))
                        }
                    </div>

                    <div class="md:hidden">
                        <label for="opere-filter-select" class="sr-only"
                            >Filtra opere per categoria</label
                        >
                        <select
                            id="opere-filter-select"
                            data-filter-select
                            class="w-full bg-[#141414] border border-white/15 text-gray-300 text-sm px-4 py-3 uppercase tracking-[0.14em]"
                        >
                            <option value="all">Tutte</option>
                            {
                                availableCategories.map((category) => (
                                    <option value={category}>
                                        {CATEGORY_LABELS[category] || category}
                                    </option>
                                ))
                            }
                        </select>
                    </div>

                    <div class="opere-curatorial-cta mt-6 md:mt-7">
                        <PercorsoTrigger />
                    </div>
                </div>
            </div>
        </section>

        <div
            id="opere-grid"
            class="opere-gallery grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-x-10 gap-y-24 max-w-7xl mx-auto"
            data-atmosfera-zone
        >
            {
                sortedWorks.map((work, index) => (
                    <OperaCard
                        href={`/opere/${work.slug}/`}
                        title={work.data.title}
                        image={work.data.featuredImage}
                        alt={work.data.imageAlt || work.data.title}
                        category={getWorkCategory(work)}
                        index={index}
                        technique={work.data.technique}
                        year={work.data.year}
                        description={work.data.description}
                        ambientColor={work.data.ambientColor}
                        memoriaSlug={work.slug}
                        eager={index < 3}
                    />
                ))
            }
        </div>

        <PercorsoOverlay works={percorsoWorks} />
    </div>

    <RevealNarrativo enabled={INTERACTIONS.reveal} selector="[data-reveal-item]" />
    <AtmosferaCromatica />
    <MemoriaVisiva enabled={INTERACTIONS.memoriaVisiva} selector="[data-memoria-slug]" />
    <GalleriaInterattiva />

    <style>
        .opere-curatorial-cta :global(div) {
            margin-bottom: 0;
            text-align: left;
        }

        .opere-curatorial-cta :global(.percorso-trigger) {
            padding: 0.68rem 1rem;
            border-color: rgba(255, 255, 255, 0.16);
            color: rgba(220, 220, 220, 0.78);
            font-size: 0.68rem;
            letter-spacing: 0.17em;
        }

        @media (min-width: 768px) {
            .opere-curatorial-cta :global(div) {
                text-align: right;
            }
        }
    </style>

</BaseLayout>
