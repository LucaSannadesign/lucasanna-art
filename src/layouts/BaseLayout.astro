---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ModalitaPercettivaToggle from "../components/ModalitaPercettivaToggle.astro";
import InterfacciaEvanescente from "../components/InterfacciaEvanescente.astro";
import TransizionePercettiva from "../components/TransizionePercettiva.astro";
import { alternatePath, localeConfig, type Locale } from "../i18n/site";
import "../styles/global.css";

interface Props {
    title: string;
    description?: string;
    image?: string;
    ogImageWidth?: number;
    ogImageHeight?: number;
    canonicalUrl?: string;
    ogType?: "website" | "article";
    context?: "home" | "blog" | "page";
    locale?: Locale;
    alternateUrl?: string | null;
}

const {
    title,
    description,
    image,
    ogImageWidth,
    ogImageHeight,
    canonicalUrl,
    ogType,
    locale = "it",
    alternateUrl,
} = Astro.props;

const localeCopy = localeConfig[locale];
const metaDescription =
    description ||
    (locale === "en"
        ? "Luca Sanna — contemporary visual art, nature and inner landscapes."
        : "Luca Sanna - Arte Visiva e Paesaggi Onirici in Sardegna");
const siteBase = Astro.site ?? new URL("https://lucasanna.art");
const absoluteImage = image ? new URL(image, siteBase).href : "";

function normalizeCanonicalUrl(value: string | URL): string {
    const url = new URL(value.toString(), siteBase);
    url.search = "";
    url.hash = "";

    const path = url.pathname;
    const lastSegment = path.split("/").filter(Boolean).at(-1) ?? "";
    const looksLikeFile = lastSegment.includes(".");

    if (path !== "/" && !looksLikeFile && !path.endsWith("/")) {
        url.pathname = `${path}/`;
    }

    return url.href;
}

const resolvedCanonicalUrl = normalizeCanonicalUrl(canonicalUrl || Astro.url);
const autoAlternatePath = alternatePath(Astro.url.pathname, locale);
const resolvedAlternateUrl =
    alternateUrl === null
        ? null
        : alternateUrl
          ? normalizeCanonicalUrl(alternateUrl)
          : autoAlternatePath
            ? normalizeCanonicalUrl(autoAlternatePath)
            : null;
const alternateLocale: Locale = locale === "it" ? "en" : "it";
const xDefaultUrl = resolvedAlternateUrl
    ? locale === "it"
        ? resolvedCanonicalUrl
        : resolvedAlternateUrl
    : null;
const resolvedOgType = ogType || "website";
const twitterCard = absoluteImage ? "summary_large_image" : "summary";
const ENABLE_PERCEPTIVE_TOGGLE = true;
const ENABLE_EVANESCENTE_UI = true;
const ENABLE_PERCETTIVE_TRANSITIONS = true;
const gaId = import.meta.env.PUBLIC_GA_ID;
const gtmId = "GTM-KZH6496M";
const ahrefsKey = "BchEV88K204OhTw6peE9Ww";
const googleFontsHref = "https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&display=swap";
---

<!doctype html>
<html lang={localeCopy.htmlLang} data-modalita-percettiva="silenzio" data-silent="true">
    <head>
        <meta charset="UTF-8" />
        <meta name="description" content={metaDescription} />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="canonical" href={resolvedCanonicalUrl} />
        <link rel="alternate" hreflang={locale} href={resolvedCanonicalUrl} />
        {
            resolvedAlternateUrl && (
                <link rel="alternate" hreflang={alternateLocale} href={resolvedAlternateUrl} />
            )
        }
        {
            xDefaultUrl && (
                <link rel="alternate" hreflang="x-default" href={xDefaultUrl} />
            )
        }
        <meta name="generator" content={Astro.generator} />
        <title>{title}</title>
        <meta property="og:title" content={title} />
        <meta property="og:description" content={metaDescription} />
        <meta property="og:url" content={resolvedCanonicalUrl} />
        <meta property="og:type" content={resolvedOgType} />
        <meta property="og:locale" content={localeCopy.ogLocale} />
        {
            resolvedAlternateUrl && (
                <meta property="og:locale:alternate" content={localeCopy.alternateOgLocale} />
            )
        }
        {
            absoluteImage && (
                <>
                    <meta property="og:image" content={absoluteImage} />
                    {ogImageWidth != null && (
                        <meta property="og:image:width" content={String(ogImageWidth)} />
                    )}
                    {ogImageHeight != null && (
                        <meta property="og:image:height" content={String(ogImageHeight)} />
                    )}
                </>
            )
        }
        <meta name="twitter:card" content={twitterCard} />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={metaDescription} />
        {absoluteImage && <meta name="twitter:image" content={absoluteImage} />}
        <script is:inline>
            document.documentElement.classList.add("js");
        </script>

        <slot name="head" />

        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href={googleFontsHref}
            rel="stylesheet"
            media="print"
            onload="this.media='all'"
        />
        <noscript><link href={googleFontsHref} rel="stylesheet" /></noscript>
    </head>
    <body class="bg-[#121212] text-[#e0e0e0] flex flex-col min-h-screen">
        <noscript>
            <iframe
                src={`https://www.googletagmanager.com/ns.html?id=${gtmId}`}
                height="0"
                width="0"
                style="display:none;visibility:hidden"
            ></iframe>
        </noscript>

        <Header locale={locale} />
        <main class="flex-grow container mx-auto px-4 py-8 mt-24 md:mt-32">
            <slot />
        </main>

        <ModalitaPercettivaToggle enabled={ENABLE_PERCEPTIVE_TOGGLE} locale={locale} />
        <InterfacciaEvanescente enabled={ENABLE_EVANESCENTE_UI} idleMs={5200} />
        <TransizionePercettiva enabled={ENABLE_PERCETTIVE_TRANSITIONS} />

        <Footer locale={locale} />

        <script is:inline define:vars={{ gaId, gtmId, ahrefsKey }}>
            (() => {
                let coreLoaded = false;
                let ahrefsLoaded = false;

                const loadCoreAnalytics = () => {
                    if (coreLoaded) return;
                    coreLoaded = true;

                    window.dataLayer = window.dataLayer || [];
                    window.dataLayer.push({ "gtm.start": Date.now(), event: "gtm.js" });

                    const gtm = document.createElement("script");
                    gtm.async = true;
                    gtm.src = `https://www.googletagmanager.com/gtm.js?id=${gtmId}`;
                    document.head.appendChild(gtm);

                    if (gaId) {
                        window.gtag = window.gtag || function gtag() {
                            window.dataLayer.push(arguments);
                        };
                        window.gtag("js", new Date());
                        window.gtag("config", gaId);

                        const ga = document.createElement("script");
                        ga.async = true;
                        ga.src = `https://www.googletagmanager.com/gtag/js?id=${gaId}`;
                        document.head.appendChild(ga);
                    }
                };

                const loadAhrefs = () => {
                    if (ahrefsLoaded) return;
                    ahrefsLoaded = true;
                    const ahrefs = document.createElement("script");
                    ahrefs.async = true;
                    ahrefs.src = "https://analytics.ahrefs.com/analytics.js";
                    ahrefs.dataset.key = ahrefsKey;
                    document.head.appendChild(ahrefs);
                };

                const loadOnEngagement = () => {
                    loadCoreAnalytics();
                    window.setTimeout(loadAhrefs, 2500);
                };

                const scheduleAfterLoad = () => {
                    window.setTimeout(loadCoreAnalytics, 12000);
                    window.setTimeout(loadAhrefs, 16000);
                };

                if (document.readyState === "complete") {
                    scheduleAfterLoad();
                } else {
                    window.addEventListener("load", scheduleAfterLoad, { once: true });
                }

                ["pointerdown", "keydown", "touchstart"].forEach((eventName) => {
                    window.addEventListener(eventName, loadOnEngagement, {
                        once: true,
                        passive: true,
                    });
                });
            })();
        </script>
    </body>
</html>
