---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ModalitaPercettivaToggle from "../components/ModalitaPercettivaToggle.astro";
import InterfacciaEvanescente from "../components/InterfacciaEvanescente.astro";
import TransizionePercettiva from "../components/TransizionePercettiva.astro";
import HomeEmergenceExperiment from "../components/art-experience/HomeEmergenceExperiment.astro";
import "../styles/global.css";

interface Props {
    title: string;
    description?: string;
    image?: string;
    ogImageWidth?: number;
    ogImageHeight?: number;
    canonicalUrl?: string;
    ogType?: "website" | "article";
    context?: "home" | "blog" | "page";
}

const { title, description, image, ogImageWidth, ogImageHeight, canonicalUrl, ogType } =
    Astro.props;
const metaDescription =
    description || "Luca Sanna - Arte Visiva e Paesaggi Onirici in Sardegna";
const absoluteImage = image
    ? new URL(image, Astro.site ?? new URL("https://lucasanna.art")).href
    : "";
const resolvedCanonicalUrl = canonicalUrl || Astro.url.href;
const resolvedOgType = ogType || "website";
const twitterCard = absoluteImage ? "summary_large_image" : "summary";
const ENABLE_PERCEPTIVE_TOGGLE = true;
const ENABLE_EVANESCENTE_UI = true;
const ENABLE_PERCETTIVE_TRANSITIONS = true;
const ENABLE_HOME_EMERGENCE_EXPERIMENT = true;
const gaId = import.meta.env.PUBLIC_GA_ID;
---

<!doctype html>
<html lang="it" data-modalita-percettiva="silenzio" data-silent="true">
    <head>
        <!-- Google Tag Manager -->
        <script is:inline>
            (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
            new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
            j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
            'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
            })(window,document,'script','dataLayer','GTM-KZH6496M');
        </script>
        <!-- End Google Tag Manager -->

        <meta charset="UTF-8" />
        <meta name="description" content={metaDescription} />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="canonical" href={resolvedCanonicalUrl} />
        <meta name="generator" content={Astro.generator} />
        <title>{title}</title>
        <meta property="og:title" content={title} />
        <meta property="og:description" content={metaDescription} />
        <meta property="og:url" content={resolvedCanonicalUrl} />
        <meta property="og:type" content={resolvedOgType} />
        {
            absoluteImage && (
                <>
                    <meta property="og:image" content={absoluteImage} />
                    {ogImageWidth != null && (
                        <meta property="og:image:width" content={String(ogImageWidth)} />
                    )}
                    {ogImageHeight != null && (
                        <meta property="og:image:height" content={String(ogImageHeight)} />
                    )}
                </>
            )
        }
        <meta name="twitter:card" content={twitterCard} />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={metaDescription} />
        {absoluteImage && <meta name="twitter:image" content={absoluteImage} />}
        <script is:inline>
            document.documentElement.classList.add("js");
        </script>

        <!-- Google Fonts -->
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&display=swap"
            rel="stylesheet"
        />

        {
            gaId && (
                <>
                    <script
                        async
                        src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}
                    ></script>
                    <script is:inline define:vars={{ gaId }}>
                        window.dataLayer = window.dataLayer || [];
                        window.gtag = function gtag() {
                            window.dataLayer.push(arguments);
                        };
                        window.gtag('js', new Date());
                        window.gtag('config', gaId);
                    </script>
                </>
            )
        }

        <script
            src="https://analytics.ahrefs.com/analytics.js"
            data-key="BchEV88K204OhTw6peE9Ww"
            async></script>
    </head>
    <body class="bg-[#121212] text-[#e0e0e0] flex flex-col min-h-screen">
        <!-- Google Tag Manager (noscript) -->
        <noscript>
            <iframe
                src="https://www.googletagmanager.com/ns.html?id=GTM-KZH6496M"
                height="0"
                width="0"
                style="display:none;visibility:hidden"
            ></iframe>
        </noscript>
        <!-- End Google Tag Manager (noscript) -->

        <Header />
        <main class="flex-grow container mx-auto px-4 py-8 mt-24 md:mt-32">
            <slot />
        </main>

        <HomeEmergenceExperiment enabled={ENABLE_HOME_EMERGENCE_EXPERIMENT} />
        <ModalitaPercettivaToggle enabled={ENABLE_PERCEPTIVE_TOGGLE} />
        <InterfacciaEvanescente enabled={ENABLE_EVANESCENTE_UI} idleMs={5200} />
        <TransizionePercettiva enabled={ENABLE_PERCETTIVE_TRANSITIONS} />

        <Footer />
    </body>
</html>
