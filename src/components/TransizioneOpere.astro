<!--
    Transizione direzionale tra opere (precedente / successiva).
    Va inserito nello slot "head" delle pagine opera: deve registrare `pagereveal`
    prima del primo rendering della nuova pagina.

    - Click su [data-work-nav="prev|next"]: memorizza la direzione e toglie il nome
      condiviso all'immagine corrente (niente morph tra due opere diverse).
    - Pagina d'arrivo con View Transition: tipo "opera-avanti" / "opera-indietro"
      (dissolvenza + 18px direzionali + scala 0.99, ~340–420 ms, CSS in global.css).
    - Browser senza View Transition: breve ingresso CSS dell'opera ([data-arrivo]).
    - La navigazione non attende mai l'animazione; con prefers-reduced-motion nulla si muove.
-->
<script is:inline>
    (() => {
        const KEY = "opera-nav-dir";
        let dir = null;
        try {
            dir = sessionStorage.getItem(KEY);
            sessionStorage.removeItem(KEY);
        } catch {}
        const type = dir === "next" ? "opera-avanti" : dir === "prev" ? "opera-indietro" : null;

        if (type) {
            const heroes = () => document.querySelectorAll("[data-vt-hero]");
            const fallback = () => {
                document.documentElement.setAttribute("data-arrivo", type);
                setTimeout(() => document.documentElement.removeAttribute("data-arrivo"), 700);
            };

            if ("onpagereveal" in window) {
                window.addEventListener(
                    "pagereveal",
                    (event) => {
                        const transition = event.viewTransition;
                        if (!transition) return fallback();
                        transition.types?.add(type);
                        heroes().forEach((el) => el.style.setProperty("view-transition-name", "none"));
                        transition.finished.finally(() =>
                            heroes().forEach((el) => el.style.removeProperty("view-transition-name")),
                        );
                    },
                    { once: true },
                );
            } else {
                fallback();
            }
        }

        if (window.__operaNavBound) return;
        window.__operaNavBound = true;
        document.addEventListener("click", (event) => {
            const link = event.target instanceof Element ? event.target.closest("a[data-work-nav]") : null;
            if (!link || event.defaultPrevented || event.button !== 0) return;
            if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
            try {
                sessionStorage.setItem(KEY, link.getAttribute("data-work-nav") || "");
            } catch {}
            document
                .querySelectorAll("[data-vt-hero], [data-viewer-img]")
                .forEach((el) => el.style.setProperty("view-transition-name", "none"));
        });
    })();
</script>
