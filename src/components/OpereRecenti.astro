---
/**
 * Opere recenti in homepage (IT/EN): composizione editoriale leggermente
 * asimmetrica (un'opera principale, due laterali, tre sfalsate).
 * Link statici; reveal, inclinazione, atmosfera e View Transition via data-attributes.
 */
import OperaImg from "./OperaImg.astro";
import { getImageMeta } from "../lib/imageMeta";

export type OperaRecente = {
    href: string;
    title: string;
    image?: string;
    alt: string;
    technique?: string;
    subtitle?: string;
    ambientColor?: string;
    lang?: string;
    titleLang?: string;
};

interface Props {
    items: OperaRecente[];
}

const { items } = Astro.props;
const ambients = await Promise.all(
    items.map(async (item) => item.ambientColor || (await getImageMeta(item.image))?.ambient),
);
const sizesFor = (index: number) =>
    index === 0
        ? "(max-width: 767px) calc(100vw - 2rem), (max-width: 1023px) calc(50vw - 3rem), 58vw"
        : "(max-width: 767px) calc(100vw - 2rem), (max-width: 1023px) calc(50vw - 3rem), 34vw";
---

<div class="opere-recenti" data-atmosfera-zone>
    {
        items.map((item, index) => (
            <a
                href={item.href}
                lang={item.lang}
                class={`opere-recenti__item opere-recenti__item--${index + 1} group block`}
                data-reveal-item
                data-reveal-order={String(index)}
                data-atmosfera-item
                data-ambient={ambients[index]}
                data-tilt
            >
                <div class="opere-recenti__media overflow-hidden mb-5" data-reveal-media data-tilt-target>
                    {item.image && (
                        <OperaImg
                            src={item.image}
                            alt={item.alt}
                            sizes={sizesFor(index)}
                            widths={index === 0 ? [480, 640, 800, 1024, 1400] : [320, 480, 640, 800]}
                            data-vt-media
                            class="w-full h-auto"
                        />
                    )}
                </div>
                <div class="opere-recenti__caption">
                    <h3 class="font-heading text-white" lang={item.titleLang}>
                        {item.title}
                    </h3>
                    {item.subtitle && <p class="opere-recenti__subtitle font-heading italic">{item.subtitle}</p>}
                    {item.technique && <p class="opere-recenti__meta">{item.technique}</p>}
                </div>
            </a>
        ))
    }
</div>

<style>
    .opere-recenti {
        display: grid;
        grid-template-columns: 1fr;
        gap: 3.5rem 2rem;
    }

    .opere-recenti__item {
        min-width: 0;
        outline: none;
    }

    .opere-recenti__media {
        transform-origin: 50% 50%;
    }

    .opere-recenti__item:focus-visible .opere-recenti__media {
        outline: 1px solid rgba(255, 255, 255, 0.75);
        outline-offset: 6px;
    }

    .opere-recenti__caption {
        text-align: left;
        max-width: 36rem;
    }

    .opere-recenti__caption h3 {
        margin: 0 0 0.35rem;
        font-size: 1.15rem !important;
        line-height: 1.3;
        letter-spacing: 0.01em;
        color: #e4e4e4;
        transition: color 300ms ease;
    }

    /* Al passaggio l'opera si avvicina appena (Rumore); in Silenzio resta ferma. */
    .opere-recenti__item:hover img,
    .opere-recenti__item:focus-visible img {
        filter: none;
        transform: scale(1.02) translateZ(0);
    }

    .opere-recenti__media img {
        transition: transform 1200ms cubic-bezier(0.22, 1, 0.36, 1);
        /* Opere verticali: altezza contenuta senza ritagliare l'opera (né layout shift). */
        max-height: 78vh;
        object-fit: contain;
        object-position: left top;
    }

    .opere-recenti__item:hover h3,
    .opere-recenti__item:focus-visible h3 {
        color: #ffffff;
    }

    .opere-recenti__subtitle {
        margin: 0 0 0.35rem;
        font-size: 0.9rem;
        color: #a8a8a8;
    }

    .opere-recenti__meta {
        margin: 0;
        font-size: 0.66rem !important;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: #969696 !important;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    /* Tablet: due colonne, la seconda leggermente abbassata. */
    @media (min-width: 768px) {
        .opere-recenti {
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 4rem 2.5rem;
        }

        .opere-recenti__item:nth-child(even) {
            margin-top: 3rem;
        }
    }

    /* Desktop: un'opera principale (7/12) e un ritmo sfalsato. */
    @media (min-width: 1024px) {
        .opere-recenti {
            grid-template-columns: repeat(12, minmax(0, 1fr));
            gap: 4.5rem 3rem;
            align-items: start;
        }

        .opere-recenti__item:nth-child(even) {
            margin-top: 0;
        }

        .opere-recenti__item--1 {
            grid-column: 1 / span 7;
            grid-row: span 2;
        }

        .opere-recenti__item--1 .opere-recenti__caption h3 {
            font-size: 1.45rem !important;
        }

        .opere-recenti__item--2 {
            grid-column: 9 / span 4;
            margin-top: 2.5rem;
        }

        .opere-recenti__item--3 {
            grid-column: 8 / span 4;
        }

        .opere-recenti__item--4 {
            grid-column: 1 / span 4;
            margin-top: 1rem;
        }

        .opere-recenti__item--5 {
            grid-column: 5 / span 4;
            margin-top: 5rem;
        }

        .opere-recenti__item--6 {
            grid-column: 9 / span 4;
            margin-top: 2.5rem;
        }
    }

    /* Profondità allo scroll (solo modalità Rumore, CSS puro sul compositore):
       le opere laterali scorrono di pochi pixel a velocità diversa. */
    @keyframes opere-recenti-profondita {
        from {
            translate: 0 22px;
        }
        to {
            translate: 0 -22px;
        }
    }

    @supports (animation-timeline: view()) {
        @media (prefers-reduced-motion: no-preference) and (min-width: 1024px) {
            :global(html[data-modalita-percettiva="rumore"]) .opere-recenti__item--2,
            :global(html[data-modalita-percettiva="rumore"]) .opere-recenti__item--5 {
                animation: opere-recenti-profondita linear both;
                animation-timeline: view();
                animation-range: entry 0% exit 100%;
            }
        }
    }
</style>
