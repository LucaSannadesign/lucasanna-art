---
interface Props {
    locale?: "it" | "en";
}

const { locale = "it" } = Astro.props;

const messages =
    locale === "en"
        ? {
              campi: "Please complete all required fields.",
              email: "The email address is not valid.",
              lunghezza: "One of the fields exceeds the maximum allowed length.",
              formato: "Invalid request. Reload the page and try again.",
              "rate-limit": "You have already sent several requests. Please try again in one hour.",
              invio: "The message could not be sent. Please try again later or email me directly.",
              rete: "Connection failed. Check your network and try again.",
          }
        : {
              campi: "Compila tutti i campi obbligatori.",
              email: "L'indirizzo email non e' valido.",
              lunghezza: "Uno dei campi supera la lunghezza massima consentita.",
              formato: "Richiesta non valida. Ricarica la pagina e riprova.",
              "rate-limit": "Hai gia' inviato diverse richieste. Riprova tra un'ora.",
              invio: "Non e' stato possibile inviare il messaggio. Riprova piu' tardi oppure scrivi direttamente via email.",
              rete: "Connessione non riuscita. Verifica la rete e riprova.",
          };

const sendingLabel = locale === "en" ? "Sending…" : "Invio in corso…";
const successRedirect = locale === "en" ? "/en/thank-you/?ok=1" : null;
---

<script is:inline define:vars={{ messages, sendingLabel, successRedirect }}>
    (() => {
        const MESSAGGI = messages;

        const mostraErrore = (form, codice, testo) => {
            const box = form.querySelector("[data-contact-error]");
            if (!box) return;
            box.textContent = MESSAGGI[codice] || testo || MESSAGGI.invio;
            box.hidden = false;
            box.scrollIntoView({ block: "nearest", behavior: "smooth" });
        };

        const nascondiErrore = (form) => {
            const box = form.querySelector("[data-contact-error]");
            if (box) box.hidden = true;
        };

        const initContactForms = () => {
            document.querySelectorAll("[data-contact-form]").forEach((form) => {
                if (!(form instanceof HTMLFormElement)) return;
                if (form.dataset.contactBound === "true") return;
                form.dataset.contactBound = "true";

                const startedAt = form.querySelector("[data-form-started-at]");
                if (startedAt instanceof HTMLInputElement) {
                    startedAt.value = String(Date.now());
                }

                form.addEventListener("submit", async (event) => {
                    event.preventDefault();
                    nascondiErrore(form);

                    const submitButton = form.querySelector('button[type="submit"]');
                    const testoOriginale =
                        submitButton instanceof HTMLButtonElement
                            ? submitButton.textContent
                            : null;

                    if (submitButton instanceof HTMLButtonElement) {
                        submitButton.disabled = true;
                        submitButton.textContent = sendingLabel;
                    }

                    try {
                        const response = await fetch(form.action, {
                            method: "POST",
                            headers: { accept: "application/json" },
                            body: new FormData(form),
                        });

                        let esito = null;
                        try {
                            esito = await response.json();
                        } catch {
                            esito = null;
                        }

                        if (response.ok && esito && esito.ok) {
                            window.location.assign(
                                successRedirect || esito.redirect || "/grazie-contatti/?ok=1",
                            );
                            return;
                        }

                        mostraErrore(
                            form,
                            (esito && esito.code) || "invio",
                            esito && esito.message,
                        );
                    } catch {
                        mostraErrore(form, "rete");
                    }

                    if (submitButton instanceof HTMLButtonElement) {
                        submitButton.disabled = false;
                        if (testoOriginale !== null) {
                            submitButton.textContent = testoOriginale;
                        }
                    }
                });
            });

            const codice = new URLSearchParams(window.location.search).get("errore");
            if (codice) {
                const form = document.querySelector("[data-contact-form]");
                if (form instanceof HTMLFormElement) mostraErrore(form, codice);
            }
        };

        initContactForms();
        document.addEventListener("astro:page-load", initContactForms);
    })();
</script>
