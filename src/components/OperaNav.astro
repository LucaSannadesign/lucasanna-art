---
/**
 * Opera precedente / successiva nella stessa sezione: link HTML statici
 * (crawlabili, funzionanti senza JS). La transizione direzionale è gestita
 * da TransizioneOpere tramite [data-work-nav].
 */
import OperaImg from "./OperaImg.astro";

type WorkLink = { href: string; title: string; image?: string; alt?: string; lang?: string } | null;

interface Props {
    prev: WorkLink;
    next: WorkLink;
    label: string;
    prevLabel: string;
    nextLabel: string;
}

const { prev, next, label, prevLabel, nextLabel } = Astro.props;
const sizes = "96px";
---

{
    (prev || next) && (
        <nav class="opera-nav" aria-label={label}>
            {prev ? (
                <a class="opera-nav__link" href={prev.href} data-work-nav="prev" rel="prev" lang={prev.lang}>
                    {prev.image && (
                        <OperaImg src={prev.image} alt="" sizes={sizes} widths={[96, 192]} fallbackWidth={192} class="opera-nav__thumb" />
                    )}
                    <span class="opera-nav__text">
                        <span class="opera-nav__dir">
                            <span aria-hidden="true">← </span>
                            {prevLabel}
                        </span>
                        <span class="opera-nav__title">{prev.title}</span>
                    </span>
                </a>
            ) : (
                <span />
            )}
            {next ? (
                <a class="opera-nav__link opera-nav__link--next" href={next.href} data-work-nav="next" rel="next" lang={next.lang}>
                    <span class="opera-nav__text">
                        <span class="opera-nav__dir">
                            {nextLabel}
                            <span aria-hidden="true"> →</span>
                        </span>
                        <span class="opera-nav__title">{next.title}</span>
                    </span>
                    {next.image && (
                        <OperaImg src={next.image} alt="" sizes={sizes} widths={[96, 192]} fallbackWidth={192} class="opera-nav__thumb" />
                    )}
                </a>
            ) : (
                <span />
            )}
        </nav>
    )
}

<style>
    .opera-nav {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1rem;
        max-width: 56rem;
        margin: 0 auto 4rem;
        padding: 1.25rem 0;
        border-top: 1px solid rgba(255, 255, 255, 0.08);
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    }

    .opera-nav__link {
        display: flex;
        align-items: center;
        gap: 0.9rem;
        min-height: 3rem;
        min-width: 0;
        color: #d4d4d4;
        text-decoration: none;
    }

    .opera-nav__link--next {
        justify-content: flex-end;
        text-align: right;
    }

    .opera-nav__thumb {
        width: 3.5rem;
        height: 3.5rem;
        object-fit: cover;
        flex: none;
        opacity: 0.85;
        transition: opacity 300ms ease;
    }

    .opera-nav__link:hover .opera-nav__thumb,
    .opera-nav__link:focus-visible .opera-nav__thumb {
        opacity: 1;
    }

    .opera-nav__text {
        display: flex;
        flex-direction: column;
        gap: 0.2rem;
        min-width: 0;
    }

    .opera-nav__dir {
        white-space: nowrap;
        font-size: 0.64rem;
        text-transform: uppercase;
        letter-spacing: 0.18em;
        color: #9a9a9a;
    }

    .opera-nav__title {
        font-family: var(--font-heading);
        font-size: 1rem;
        line-height: 1.3;
        overflow: hidden;
        text-overflow: ellipsis;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
    }

    .opera-nav__link:hover .opera-nav__title {
        color: #ffffff;
    }

    .opera-nav__link:focus-visible {
        outline: 2px solid #e8e8e8;
        outline-offset: 4px;
    }

    @media (max-width: 640px) {
        .opera-nav__thumb {
            width: 2.75rem;
            height: 2.75rem;
        }

        .opera-nav__title {
            font-size: 0.9rem;
        }
    }
</style>
