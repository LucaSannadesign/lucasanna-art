---
interface Props {
    enabled?: boolean;
    locale?: "it" | "en";
}

const { enabled = true, locale = "it" } = Astro.props;
const copy = locale === "en"
    ? {
          ariaLabel: "Reduce animations and visual transitions",
          label: "Reduce motion",
          silent: "Quiet",
          noise: "Active",
      }
    : {
          ariaLabel: "Riduci animazioni e transizioni visive",
          label: "Riduci animazioni",
          silent: "Silenzio",
          noise: "Rumore",
      };
---

<button
    type="button"
    class="modalita-toggle"
    data-modalita-toggle
    data-enabled={enabled ? "true" : "false"}
    data-silent-label={copy.silent}
    data-noise-label={copy.noise}
    aria-label={copy.ariaLabel}
    title={copy.ariaLabel}
>
    <span class="modalita-toggle__label">{copy.label}</span>
    <span class="modalita-toggle__value" data-modalita-value>{copy.silent}</span>
</button>

<script is:inline>
    const MODALITA_KEY = "modalita-percettiva";

    const initModalitaPercettiva = () => {
        const toggle = document.querySelector("[data-modalita-toggle]");
        if (!(toggle instanceof HTMLButtonElement) || toggle.dataset.enabled !== "true") return;
        if (toggle.dataset.bound === "true") return;
        toggle.dataset.bound = "true";

        const valueNode = toggle.querySelector("[data-modalita-value]");
        const validModes = new Set(["silenzio", "rumore"]);
        const silentLabel = toggle.dataset.silentLabel || "Silenzio";
        const noiseLabel = toggle.dataset.noiseLabel || "Rumore";

        const applyMode = (mode) => {
            const normalized = validModes.has(mode) ? mode : "silenzio";
            document.documentElement.setAttribute("data-modalita-percettiva", normalized);
            document.documentElement.setAttribute(
                "data-silent",
                normalized === "silenzio" ? "true" : "false",
            );
            if (valueNode) valueNode.textContent = normalized === "silenzio" ? silentLabel : noiseLabel;
            localStorage.setItem(MODALITA_KEY, normalized);
        };

        const initial = localStorage.getItem(MODALITA_KEY) || document.documentElement.getAttribute("data-modalita-percettiva") || "silenzio";
        applyMode(initial);

        toggle.addEventListener("click", () => {
            const current = document.documentElement.getAttribute("data-modalita-percettiva") || "silenzio";
            applyMode(current === "silenzio" ? "rumore" : "silenzio");
        });
    };

    initModalitaPercettiva();
    document.addEventListener("astro:page-load", initModalitaPercettiva);
</script>

<style>
    .modalita-toggle {
        position: fixed;
        right: 1rem;
        bottom: 1rem;
        z-index: 70;
        border: 1px solid rgba(255, 255, 255, 0.24);
        background: rgba(11, 11, 11, 0.86);
        color: #ececec;
        padding: 0.5rem 0.7rem;
        display: inline-flex;
        gap: 0.55rem;
        align-items: baseline;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        font-size: 0.58rem;
        backdrop-filter: blur(6px);
    }

    .modalita-toggle__value {
        color: #fff;
        font-size: 0.62rem;
    }
</style>
