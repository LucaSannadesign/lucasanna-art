---
import { Image } from "astro:assets";
import logo from "../assets/logo.webp";
import {
    languageSwitcherPath,
    localeConfig,
    localizedPath,
    type Locale,
} from "../i18n/site";

interface Props {
    locale?: Locale;
}

const { locale = "it" } = Astro.props;
const copy = localeConfig[locale];
const switchHref = languageSwitcherPath(Astro.url.pathname, locale);
const switchLabel = locale === "it" ? "EN" : "IT";

const links = [
    { name: copy.nav.home, href: localizedPath("home", locale) },
    { name: copy.nav.works, href: localizedPath("works", locale) },
    { name: copy.nav.bio, href: localizedPath("bio", locale) },
    { name: copy.nav.blog, href: localizedPath("blog", locale) },
    { name: copy.nav.contact, href: localizedPath("contact", locale) },
];
---

<header
    class="w-full py-6 md:py-8 px-6 md:px-12 flex justify-between items-center bg-[#121212]/90 backdrop-blur-md fixed top-0 left-0 right-0 z-50 border-b border-white/5 transition-all duration-300"
>
    <a
        href={localizedPath("home", locale)}
        class="block w-40 md:w-48 opacity-90 hover:opacity-100 transition-opacity"
    >
        <Image src={logo} alt="Luca Sanna Logo" class="w-full h-auto" />
    </a>

    <div class="hidden md:flex items-center gap-6 lg:gap-8">
        <nav
            class="flex gap-7 lg:gap-10 text-gray-300 uppercase tracking-[0.2em] text-xs font-medium"
            aria-label={locale === "it" ? "Navigazione principale" : "Primary navigation"}
        >
            {
                links.map((link) => (
                    <a
                        href={link.href}
                        class="hover:text-white transition-colors duration-300 py-1 border-b border-transparent hover:border-white/40"
                    >
                        {link.name}
                    </a>
                ))
            }
        </nav>

        <a
            href={switchHref}
            hreflang={locale === "it" ? "en" : "it"}
            lang={locale === "it" ? "en" : "it"}
            aria-label={copy.languageSwitchLabel}
            class="border-l border-white/10 pl-5 text-[0.65rem] font-medium tracking-[0.18em] text-gray-500 transition-colors hover:text-white"
        >
            {switchLabel}
        </a>
    </div>

    <button
        id="mobile-menu-btn"
        class="md:hidden text-white focus:outline-none p-2"
        aria-label="Menu"
    >
        <svg
            class="w-6 h-6"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
        >
            <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="1.5"
                d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
    </button>
</header>
<div
    id="mobile-menu"
    class="hidden fixed inset-0 bg-[#0a0a0a] z-[60] flex flex-col items-center justify-center space-y-10 text-2xl font-light tracking-widest"
>
    {
        links.map((link) => (
            <a
                href={link.href}
                class="text-gray-300 hover:text-white transition-colors mobile-link"
            >
                {link.name}
            </a>
        ))
    }

    <a
        href={switchHref}
        hreflang={locale === "it" ? "en" : "it"}
        lang={locale === "it" ? "en" : "it"}
        aria-label={copy.languageSwitchLabel}
        class="text-sm uppercase tracking-[0.22em] text-gray-500 hover:text-white transition-colors mobile-link"
    >
        {switchLabel}
    </a>

    <button
        id="close-menu-btn"
        class="absolute top-6 right-6 text-gray-400 hover:text-white transition-colors p-2"
        aria-label={copy.closeMenu}
    >
        <svg
            class="w-8 h-8"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
        >
            <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="1.5"
                d="M6 18L18 6M6 6l12 12"></path>
        </svg>
    </button>
</div>

<script>
    const btn = document.getElementById("mobile-menu-btn");
    const menu = document.getElementById("mobile-menu");
    const closeBtn = document.getElementById("close-menu-btn");

    if (btn && menu && closeBtn) {
        btn.addEventListener("click", () => {
            menu.classList.remove("hidden");
        });
        closeBtn.addEventListener("click", () => {
            menu.classList.add("hidden");
        });
    }
</script>
