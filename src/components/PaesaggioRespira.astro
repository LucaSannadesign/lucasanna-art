---
interface Props {
  selector?: string;
  enabled?: boolean;
}
const { selector = "[data-paesaggio-respira]", enabled = true } = Astro.props;
---

<script is:inline define:vars={{ selector, enabled }}>
(() => {
  if (!enabled) return;
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)");

  const init = () => {
    document.querySelectorAll(selector).forEach((root) => {
      if (!(root instanceof HTMLElement) || root.dataset.respiraBound === "true") return;
      const img = root.querySelector("[data-respira-image]");
      if (!(img instanceof HTMLImageElement)) return;
      root.dataset.respiraBound = "true";

      let tx = 0, ty = 0, sx = 0, sy = 0, cx = 0, cy = 0, cs = 0, raf = 0, inView = false;

      const paint = () => {
        const e = reduce.matches ? 1 : 0.09;
        cx += (tx - cx) * e;
        cy += (ty - cy) * e;
        cs += (sy - cs) * (reduce.matches ? 1 : 0.07);
        root.style.setProperty("--respira-tx", cx.toFixed(2) + "px");
        root.style.setProperty("--respira-ty", cy.toFixed(2) + "px");
        root.style.setProperty("--respira-scroll", cs.toFixed(2) + "px");

        if (Math.abs(tx-cx) > .02 || Math.abs(ty-cy) > .02 || Math.abs(sy-cs) > .02) {
          raf = requestAnimationFrame(paint);
        } else {
          raf = 0;
        }
      };

      const kick = () => { if (!raf) raf = requestAnimationFrame(paint); };

      const scrollUpdate = () => {
        if (!inView || reduce.matches) {
          sy = 0;
        } else {
          const rect = root.getBoundingClientRect();
          const n = Math.max(-1, Math.min(1, (rect.top + rect.height / 2 - innerHeight / 2) / innerHeight));
          sy = n * -14;
        }
        kick();
      };

      root.addEventListener("pointermove", (event) => {
        if (reduce.matches) return;
        const rect = root.getBoundingClientRect();
        const nx = Math.max(0, Math.min(1, (event.clientX - rect.left) / rect.width));
        const ny = Math.max(0, Math.min(1, (event.clientY - rect.top) / rect.height));
        tx = (nx - .5) * -14;
        ty = (ny - .5) * -10;
        root.style.setProperty("--respira-x", (nx * 100).toFixed(1) + "%");
        root.style.setProperty("--respira-y", (ny * 100).toFixed(1) + "%");
        root.style.setProperty("--respira-rx", ((.5 - ny) * 3).toFixed(2) + "deg");
        root.style.setProperty("--respira-ry", ((nx - .5) * 3.8).toFixed(2) + "deg");
        kick();
      });

      root.addEventListener("pointerleave", () => {
        tx = 0; ty = 0;
        root.style.setProperty("--respira-x", "50%");
        root.style.setProperty("--respira-y", "50%");
        root.style.setProperty("--respira-rx", "0deg");
        root.style.setProperty("--respira-ry", "0deg");
        kick();
      });

      new IntersectionObserver((entries) => {
        inView = Boolean(entries[0]?.isIntersecting);
        root.dataset.respiraVisible = inView ? "true" : "false";
        scrollUpdate();
      }, { threshold: [0, .2, .6] }).observe(root);

      addEventListener("scroll", scrollUpdate, { passive: true });
      addEventListener("resize", scrollUpdate, { passive: true });
      reduce.addEventListener?.("change", () => {
        tx = 0; ty = 0; sy = 0;
        kick();
      });
    });
  };

  init();
  document.addEventListener("astro:page-load", init);
})();
</script>

<style is:global>
[data-paesaggio-respira] {
  --respira-tx: 0px;
  --respira-ty: 0px;
  --respira-scroll: 0px;
  --respira-x: 50%;
  --respira-y: 50%;
  --respira-rx: 0deg;
  --respira-ry: 0deg;
  position: relative;
  overflow: hidden;
  isolation: isolate;
  perspective: 1200px;
  background: #090909;
  box-shadow: 0 34px 90px rgba(0,0,0,.42);
}
[data-paesaggio-respira]::before,
[data-paesaggio-respira]::after {
  content: "";
  position: absolute;
  inset: 0;
  pointer-events: none;
  z-index: 2;
}
[data-paesaggio-respira]::before {
  inset: -15%;
  background:
    radial-gradient(circle at var(--respira-x) var(--respira-y), rgba(231,203,165,.24), rgba(118,160,171,.09) 18%, transparent 46%),
    radial-gradient(circle at 72% 18%, rgba(146,109,81,.08), transparent 34%);
  mix-blend-mode: screen;
  animation: respira-luce 8s ease-in-out infinite alternate;
}
[data-paesaggio-respira]::after {
  background: linear-gradient(110deg, transparent 0 42%, rgba(255,255,255,0) 46%, rgba(234,213,182,.13) 49.5%, rgba(111,156,168,.07) 51%, rgba(255,255,255,0) 55%, transparent 60%);
  background-size: 260% 100%;
  opacity: .35;
  animation: respira-scan 12s cubic-bezier(.4,0,.2,1) infinite;
}
[data-paesaggio-respira] [data-respira-image] {
  transform:
    perspective(1200px)
    translate3d(var(--respira-tx), calc(var(--respira-ty) + var(--respira-scroll)), 0)
    rotateX(var(--respira-rx))
    rotateY(var(--respira-ry))
    scale(1.055);
  filter: saturate(.92) contrast(1.025) brightness(.96);
  transition: filter .9s cubic-bezier(.22,1,.36,1);
  will-change: transform, filter;
  backface-visibility: hidden;
}
[data-paesaggio-respira]:hover [data-respira-image] {
  filter: saturate(1.09) contrast(1.045) brightness(1.02);
}
@keyframes respira-luce {
  from { opacity: .42; transform: scale(1.02) translate3d(-.8%, .4%, 0); }
  to { opacity: .9; transform: scale(1.08) translate3d(.8%, -.4%, 0); }
}
@keyframes respira-scan {
  0%,18% { background-position: 180% 0; opacity: .08; }
  48% { opacity: .46; }
  82%,100% { background-position: -80% 0; opacity: .08; }
}
html[data-silent="true"] [data-paesaggio-respira]::before {
  animation: respira-luce 12s ease-in-out infinite alternate !important;
}
html[data-silent="true"] [data-paesaggio-respira]::after {
  animation: respira-scan 16s ease-in-out infinite !important;
}
html[data-silent="true"] [data-paesaggio-respira] [data-respira-image] {
  transform:
    perspective(1200px)
    translate3d(var(--respira-tx), calc(var(--respira-ty) + var(--respira-scroll)), 0)
    rotateX(var(--respira-rx))
    rotateY(var(--respira-ry))
    scale(1.038) !important;
  filter: saturate(.95) contrast(1.02) !important;
  transition-duration: .9s !important;
}
@media (prefers-reduced-motion: reduce) {
  [data-paesaggio-respira]::before,
  [data-paesaggio-respira]::after { animation: none !important; }
  [data-paesaggio-respira] [data-respira-image],
  html[data-silent="true"] [data-paesaggio-respira] [data-respira-image] {
    transform: none !important;
    filter: none !important;
    transition: none !important;
  }
}
</style>
