# Configurazione SMTP per l'invio dei form del sito (/api/contatti).
# Copiare in .env.local per lo sviluppo e configurare gli stessi valori
# su Netlify (Site configuration > Environment variables).
# NON inserire qui valori reali o password: questo file e' versionato.

# Host del server SMTP fornito dal provider di posta del dominio.
SMTP_HOST=
# 465 con SMTP_SECURE=true (TLS implicito) oppure 587 con SMTP_SECURE=false (STARTTLS).
SMTP_PORT=
# true per la porta 465, false per la 587. Se omessa viene dedotta dalla porta.
SMTP_SECURE=
# Utente di autenticazione SMTP (di norma l'indirizzo completo della casella).
SMTP_USER=
# Password della casella o app password dedicata.
SMTP_PASSWORD=
# Mittente: deve appartenere al dominio lucasanna.art per non fallire SPF/DKIM.
# Esempio: "Luca Sanna <no-reply@lucasanna.art>"
SMTP_FROM=
# Destinatario che riceve le richieste inviate dal sito.
CONTACT_RECIPIENT=
